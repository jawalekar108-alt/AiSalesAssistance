<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="ig" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f09433"/>
      <stop offset="25%" stop-color="#e6683c"/>
      <stop offset="50%" stop-color="#dc2743"/>
      <stop offset="75%" stop-color="#cc2366"/>
      <stop offset="100%" stop-color="#bc1888"/>
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8b5cf6"/>
      <stop offset="100%" stop-color="#3b82f6"/>
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="120" fill="#0b0f17"/>
  <rect x="24" y="24" width="464" height="464" rx="100" fill="url(#ig)" opacity="0.15"/>
  <rect x="40" y="40" width="432" height="432" rx="90" fill="none" stroke="url(#ig)" stroke-width="8"/>
  
  <!-- Robot & Shopping Icon -->
  <circle cx="256" cy="200" r="80" fill="url(#glow)"/>
  <circle cx="230" cy="190" r="14" fill="#ffffff"/>
  <circle cx="282" cy="190" r="14" fill="#ffffff"/>
  <path d="M 220 230 Q 256 260 292 230" stroke="#ffffff" stroke-width="8" stroke-linecap="round" fill="none"/>
  
  <!-- Antenna -->
  <line x1="256" y1="120" x2="256" y2="80" stroke="#8b5cf6" stroke-width="8" stroke-linecap="round"/>
  <circle cx="256" cy="70" r="16" fill="#34d399"/>
  
  <!-- Shopping Bag / Cart Base -->
  <path d="M 160 310 L 352 310 L 330 420 L 182 420 Z" fill="url(#ig)"/>
  <path d="M 210 310 C 210 270 302 270 302 310" stroke="#ffffff" stroke-width="8" stroke-linecap="round" fill="none"/>
  <text x="256" y="380" font-family="-apple-system, sans-serif" font-size="36" font-weight="900" fill="#ffffff" text-anchor="middle">24/7</text>
</svg>